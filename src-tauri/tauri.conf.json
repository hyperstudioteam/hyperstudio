{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperStudio",
  "version": "0.1.6",
  "identifier": "dev.hyperstudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: https:; script-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/plugins/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
